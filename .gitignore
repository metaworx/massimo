# secrets and local experiment output; .env.* covers copies and the
# files picked with -env, which hold the same keys, IVs and token
.env
.env.*
!.env.example
*.exe
portal-capture.jsonl
# serve -log and legacy -out (device names, state changes, portal credentials)
*.log
/massimo
/dist/
# backups taken with "massimo backup" (contain device serials and names)
massimo-backup-*
/cube*.json
/cube*.yaml
/cube*.yml
/backups/

# Claude Code agent worktrees
/.claude/worktrees/

# Firmware dumps (eQ-3 proprietary, never commit)
/firmware/
*.bin

# Python environment of the web UI smoke test
/tools/ui-test/.venv/
# what the suite leaves behind: the traces, screenshots and videos of
# failed tests, and pytest's cache
/tools/ui-test/results/
/tools/ui-test/.pytest_cache/

# serve's store (internal/store): the Cubes, settings, the node key and
# the OPAQUE key
massimo.db
massimo.db-*
massimo.db.before-*
node.key
opaque.key

# Python leaves it behind wherever the UI smoke test runs.
__pycache__/
