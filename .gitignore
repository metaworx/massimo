# secrets and local experiment output; .env.* covers copies and the
# files picked with -env, which hold the same keys, IVs and token
.env
.env.*
!.env.example
*.exe
portal-capture.jsonl
# serve -log and legacy -out (device names, state changes, portal credentials)
*.log
/massimo
/dist/
# backups taken with "massimo backup" (contain device serials and names)
massimo-backup-*
/cube*.json
/cube*.yaml
/cube*.yml
/backups/

# Claude Code agent worktrees
/.claude/worktrees/

# Firmware dumps (eQ-3 proprietary, never commit)
/firmware/
*.bin

# Python environment of the web UI smoke test
/tools/ui-test/.venv/
# Python environment of the brand generator
/tools/brand/.venv/
# what the suite leaves behind: the traces, screenshots and videos of
# failed tests, and pytest's cache
/tools/ui-test/results/
/tools/ui-test/.pytest_cache/
# what the emulator suite leaves behind: its logs, the servers', the
# screens of failed tests and Gradle's report (tools/app-emulator/)
/tools/app-emulator/results/

# serve's store (internal/store): the Cubes, settings, the node key and
# the OPAQUE key
massimo.db
massimo.db-*
massimo.db.before-*
node.key
opaque.key
# and serve's TLS certificates with their keys (internal/certs): the
# self-signed pair and the ACME ones, in the data directory's tls/
/tls/

# Python leaves it behind wherever the UI smoke test runs.
__pycache__/

# The web UI's parts, bundled by make ui from internal/server/ui/src/
# (tools/uibundle) and embedded; built wherever Go is compiled, never
# committed (AP UiParts, D172-A).
/internal/server/ui/parts.js
# The type check's TypeScript (make ui-check), installed by npm ci.
node_modules/
