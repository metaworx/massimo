massimo-backup-*
/cube*.json
/cube*.yaml
/cube*.yml
/backups/

# Claude Code agent worktrees
/.claude/worktrees/

# Firmware dumps (eQ-3 proprietary, never commit)
/firmware/
*.bin

# Python environment of the web UI smoke test
/tools/ui-test/.venv/
