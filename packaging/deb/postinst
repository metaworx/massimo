#!/bin/sh
# The massimo package's postinst: what `massimo install` does on a box
# without the package, with Debian's tools (packaging/README.md, "Debian
# package"): the system user, the settings directory and file, the unit
# enabled (the reboot helper's only once the owner enabled it), and the
# service restarted with the new binary when it runs, started when the
# settings are filled in, and otherwise left for the owner to start.
set -e

# settings prints the lines of a settings file that set something, without
# the comments and blank lines: a release that changes the template's
# comments does not make an untouched file look filled in.
settings() {
	sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v -e '^#' -e '^$' || true
}

case "$1" in
configure)
	if ! getent passwd massimo >/dev/null; then
		adduser --system --group --home /var/lib/massimo --no-create-home \
			--shell /usr/sbin/nologin --quiet massimo
	fi
	if [ ! -d /etc/massimo ]; then
		install -d -m 0750 -o massimo -g massimo /etc/massimo
	fi
	# Written once, never replaced: it holds the Cube keys and the token.
	if [ ! -e /etc/massimo/env ]; then
		install -m 0600 -o massimo -g massimo /usr/share/massimo/env.template /etc/massimo/env
	fi
	# systemd makes it at the first start (StateDirectory=); made here, so
	# that `massimo user add` can create the owner before that.
	if [ ! -d /var/lib/massimo ]; then
		install -d -m 0750 -o massimo -g massimo /var/lib/massimo
	fi
	# Enabled as `massimo install` enables (debhelper's snippet, so that a
	# box without a running systemd gets the same symlinks).
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper unmask massimo.service >/dev/null || true
		if deb-systemd-helper --quiet was-enabled massimo.service; then
			deb-systemd-helper enable massimo.service >/dev/null || true
		else
			deb-systemd-helper update-state massimo.service >/dev/null || true
		fi
		# The reboot helper stays off until the owner turns it on with
		# `massimo install -reboot-helper`, and on once turned on: debhelper's
		# snippet for a unit it does not enable (was-enabled is true on a
		# first install, debian-installed is not).
		if deb-systemd-helper debian-installed massimo-reboot.path; then
			deb-systemd-helper unmask massimo-reboot.path >/dev/null || true
			if deb-systemd-helper --quiet was-enabled massimo-reboot.path; then
				deb-systemd-helper enable massimo-reboot.path >/dev/null || true
			fi
		fi
		deb-systemd-helper update-state massimo-reboot.path >/dev/null || true
	fi
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		# Restarted with the new binary when it runs, whatever the settings;
		# started when they set more than the template does. A box that never
		# ran on the template's settings is left for its owner: until it has
		# an owner, every device on the local network may use it.
		state=$(systemctl is-active massimo.service 2>/dev/null || true)
		case "$state" in
		active | activating | reloading) start=yes ;;
		*) start=no ;;
		esac
		if [ "$(settings /etc/massimo/env)" != "$(settings /usr/share/massimo/env.template)" ]; then
			start=yes
		fi
		if [ "$start" = no ]; then
			echo "massimo: not started: until it has an owner, every device on the local network may use it" >&2
			echo "massimo: create the owner first: sudo -u massimo massimo -data /var/lib/massimo user add <name> -role owner" >&2
			echo "massimo: then start it: sudo systemctl start massimo" >&2
			echo "massimo: or start it and create the owner in the web UI; the Cubes are added there (System settings → Cubes)" >&2
		elif command -v deb-systemd-invoke >/dev/null 2>&1; then
			deb-systemd-invoke restart massimo.service >/dev/null || true
		fi
	fi
	;;
esac
exit 0
