#!/bin/sh
# The massimo package's postrm: a removal leaves the settings, the store,
# the logs and the user, as `massimo install -remove` does; a purge takes
# them too, as `-remove -purge` does.
set -e

# logrotate's file of the releases before 0.14.0~alpha.2: serve rotates its
# log itself now, so the conffile goes, unless the owner changed it
# (dpkg-maintscript-helper(1), rm_conffile; the same line in the preinst,
# the postinst and the postrm).
dpkg-maintscript-helper rm_conffile /etc/logrotate.d/massimo 0.14.0~alpha.2~ -- "$@"

case "$1" in
remove)
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
	fi
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper mask massimo.service massimo-update.path massimo-reboot.path >/dev/null || true
	fi
	;;
purge)
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper purge massimo.service massimo-update.path massimo-reboot.path >/dev/null || true
		deb-systemd-helper unmask massimo.service massimo-update.path massimo-reboot.path >/dev/null || true
	fi
	rm -rf /etc/massimo /var/lib/massimo /var/lib/massimo-update /var/log/massimo
	if getent passwd _massimo >/dev/null; then
		deluser --system --quiet _massimo || true
	fi
	if getent group _massimo >/dev/null; then
		delgroup --system --quiet _massimo || true
	fi
	# An older package's account massimo, where nothing renamed it since;
	# a person's massimo, whose home is elsewhere, stays.
	if [ "$(getent passwd massimo | cut -d: -f6)" = /var/lib/massimo ]; then
		deluser --system --quiet massimo || true
		delgroup --system --quiet massimo 2>/dev/null || true
	fi
	;;
esac
exit 0
