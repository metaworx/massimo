# systemd unit for "massimo serve": keeps the Cubes connected, serves the
# JSON API and web UI on port 8099 and answers as a Cube on TCP 62910 and
# UDP 23272. "massimo install" writes it (see packaging/README.md).

[Unit]
Description=Massimo server for MAX! Cubes
Documentation=https://go.metaworx.ch/massimo
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=_massimo
Group=_massimo
# Settings and secrets (MASSIMO_CUBE_<SN>_ADDRESS, _KEY, _IV, _PROXY,
# MASSIMO_API_TOKEN) are read by massimo itself from this file, mode 0600,
# owned by _massimo. Add "-proxy off" for a first run without the LAN proxy.
# -data is the directory of the store, massimo.db (the Cubes and the
# server's settings after the first start), the state directory below.
# -update-request lets the web UI ask massimo-update.service (root) to
# install a newer release; without that unit installed, drop it.
# The API and web UI address; `massimo install -listen <addr>` sets it in
# massimo.service.d/listen.conf (with the capability for a port below 1024).
Environment=MASSIMO_LISTEN=:8099
ExecStart=/usr/local/bin/massimo -env /etc/massimo/env -data /var/lib/massimo serve -listen ${MASSIMO_LISTEN} -log /var/log/massimo/serve.log -update-request /var/lib/massimo/update-request
Restart=on-failure
RestartSec=10s
# A restart from the API or the web UI stops the server and exits with
# 75, which is started again and not counted as a failure.
RestartForceExitStatus=75
SuccessExitStatus=75
# systemctl reload massimo: the settings file read again, MASSIMO_API_TOKEN
# applied at once, and the store checkpointed.
ExecReload=/bin/kill -HUP $MAINPID
WorkingDirectory=/var/lib/massimo
# The store: 0750, set at every start, also on a directory that exists;
# systemd's default is 0755.
StateDirectory=massimo
StateDirectoryMode=0750
# The log: /var/log/massimo, _massimo:adm 2750 from the package's postinst
# or massimo install, so that the files serve makes there (0640) are the
# admin group's to read. Not LogsDirectory=, which would give the
# directory back to the service's own group at every start.
ReadWritePaths=-/var/log/massimo

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
